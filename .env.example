# Copy to .env at the repository root and to backend/.env.
APP_NAME=EduAI Suite
APP_VERSION=1.0.0
DEBUG=True

# Generate separate values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

POSTGRES_DB=eduai_db
POSTGRES_USER=eduai
POSTGRES_PASSWORD=change-this-local-password
DATABASE_URL=postgresql://eduai:change-this-local-password@localhost:5432/eduai_db

GOOGLE_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

REDIS_URL=redis://localhost:6379
CHROMA_PERSIST_DIR=./chroma_db
